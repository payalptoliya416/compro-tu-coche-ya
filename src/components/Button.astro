---
import { Icon } from 'astro-icon/components';

type Variant = 'primary' | 'navy' | 'white';
type Size = 'sm' | 'md';

const {
  href,
  variant = 'primary',
  size = 'md',
  icon = true,
  class: cls = '',
  type = 'button',
} = Astro.props as {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
};

const styles: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-brand-dark',
  navy: 'bg-navy text-white hover:bg-navy-deep',
  white: 'bg-white text-navy hover:bg-white/90',
};
const circle: Record<Variant, string> = {
  primary: 'bg-white text-[#02214A]',
  navy: 'bg-white text-[#02214A]',
  white: 'bg-navy text-white',
};
const sizes: Record<Size, string> = {
  sm: 'h-11 pl-5 pr-1.5 text-base gap-3',
  md: 'h-11 pl-6 pr-1.5 text-sm gap-3',
};

const base = 'inline-flex shrink-0 items-center justify-center rounded-full font-medium transition-colors';
const classes = [base, styles[variant], sizes[size], cls].filter(Boolean).join(' ');
---
{href ? (
  <a href={href} class={classes}>
    <span><slot /></span>
    {icon && (
      <span class:list={['grid size-8 place-items-center rounded-full', circle[variant]]}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-3.5 sm:size-[18]">
          <path d="M3.46155 15L15 3.46155M15 12.1154V3.46155H6.34616" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    )}
  </a>
) : (
  <button type={type} class={classes}>
    <span><slot /></span>
    {icon && (
      <span class:list={['grid size-8 place-items-center rounded-full', circle[variant]]}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-3.5 sm:size-[18]">
          <path d="M3.46155 15L15 3.46155M15 12.1154V3.46155H6.34616" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    )}
  </button>
)}
