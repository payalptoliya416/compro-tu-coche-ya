---
const { light = false, class: cls = '' } = Astro.props;
---

<a
  href="/"
  class:list={['inline-flex shrink-0 items-center transition-opacity hover:opacity-95', cls]}
  aria-label="Compro Tu Coche Ya"
>
  {light ? (
    <img
      src="/images/light-logo.png"
      alt="Compro Tu Coche Ya"
      class="w-full max-w-[240px] sm:max-w-[290px]"
    />
  ) : (
    <img
      src="/images/logo.png"
      alt="Compro Tu Coche Ya"
      class="w-full max-w-[190px] sm:max-w-[240px]"
    />
  )}
</a>