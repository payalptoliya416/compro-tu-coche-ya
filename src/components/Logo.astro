---
const { light = false, class: cls = '' } = Astro.props;
---
<a href="/" class:list={['inline-flex items-center gap-2.5 transition-opacity hover:opacity-95', cls]} aria-label="Compro Tu Coche Ya">
  {light ? (
    <div class="flex items-center gap-2.5">
      <svg viewBox="0 0 56 34" class="h-8 w-11 shrink-0" fill="none" aria-hidden="true">
        <path d="M1 12h9M0 17h12M3 22h8" stroke="#ff5a0f" stroke-width="2.2" stroke-linecap="round" />
        <path d="M14 22l3-9q1-3 4-3h14q3 0 5 3l5 7q4 1 4 5v2H14z" fill="#ffffff" />
        <path d="M20 13h8v6H18z" fill="#06224d" opacity=".9" />
        <circle cx="23" cy="27" r="4.5" fill="#ffffff" stroke="#ff5a0f" stroke-width="2" />
        <circle cx="40" cy="27" r="4.5" fill="#ffffff" stroke="#ff5a0f" stroke-width="2" />
      </svg>
      <span class="leading-none text-white">
        <span class="block text-[15px] font-extrabold tracking-tight">COMPRO TU COCHE <span class="text-brand">YA</span></span>
        <span class="mt-1 block text-[6.5px] font-medium tracking-[0.3em] text-white/70">VENDE HOY • COBRA HOY</span>
      </span>
    </div>
  ) : (
    <img src="/images/logo.png" alt="Compro Tu Coche Ya" class="h-8 md:h-9 w-auto object-contain" />
  )}
</a>
