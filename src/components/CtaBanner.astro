---
import PlatePill from './PlatePill.astro';
import TrustRow from './TrustRow.astro';
---
<div class="relative isolate overflow-hidden rounded-[26px] px-4 py-10 sm:py-12 md:py-14 text-center text-white shadow-2xl">
  <!-- Background image of smiling couple -->
  <img
    src="/images/cta-bg.png"
    alt=""
    class="absolute inset-0 -z-20 size-full object-cover object-[center_35%]"
  />

  <!-- Content -->
  <h2 class="text-2xl sm:text-3xl md:text-[34px] font-medium tracking-tight text-white leading-tight">
    Do you want to sell your car today?
  </h2>
  <p class="mt-3 text-sm sm:text-base text-white mx-auto">
    Start with your registration and find out how much it can be worth.
  </p>
  <p class="mb-2.5 mt-6 text-sm text-white tracking-wide">
    Enter your license plate number
  </p>
  <PlatePill />
  <TrustRow class="mt-3.5" />
</div>
