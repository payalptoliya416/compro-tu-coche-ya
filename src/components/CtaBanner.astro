---
import PlatePill from './PlatePill.astro';
import TrustRow from './TrustRow.astro';
import { images } from '../data/images';
---
<div class="relative isolate overflow-hidden rounded-3xl bg-brand px-4 py-10 text-center text-white md:py-12">
  <img src={images.ctaBg} alt="" class="absolute inset-0 -z-20 size-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-brand/85"></div>
  <h2 class="text-2xl font-bold md:text-[32px]">Do you want to sell your car today?</h2>
  <p class="mt-2 text-sm text-white/90">Start with your registration and find out how much it can be worth.</p>
  <p class="mb-2 mt-6 text-xs">Enter your license plate number</p>
  <PlatePill />
  <TrustRow class="mt-3" />
</div>
