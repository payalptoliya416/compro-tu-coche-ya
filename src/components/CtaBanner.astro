---
import PlatePill from './PlatePill.astro';
import TrustRow from './TrustRow.astro';
---
<div class="relative isolate overflow-hidden rounded-[26px] md:rounded-[34px] px-4 py-10 sm:py-12 md:py-14 text-center text-white shadow-2xl">
  <!-- Background image of smiling couple -->
  <img
    src="/images/home-hero.png"
    alt=""
    class="absolute inset-0 -z-20 size-full object-cover object-[center_35%]"
  />
  <!-- Warm orange/amber overlay matching design -->
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-[#ba440d]/92 via-[#cb4d0f]/88 to-[#9b3407]/92"></div>
  <div class="absolute inset-0 -z-10 bg-black/25"></div>

  <!-- Content -->
  <h2 class="text-2xl sm:text-3xl md:text-[34px] font-bold tracking-tight text-white leading-tight">
    Do you want to sell your car today?
  </h2>
  <p class="mt-2 text-sm sm:text-base text-white/95 max-w-lg mx-auto">
    Start with your registration and find out how much it can be worth.
  </p>
  <p class="mb-2.5 mt-6 text-xs text-white/85 font-medium tracking-wide">
    Enter your license plate number
  </p>
  <PlatePill />
  <TrustRow class="mt-3.5" />
</div>
