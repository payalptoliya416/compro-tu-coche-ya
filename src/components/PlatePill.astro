---
import { Icon } from 'astro-icon/components';
---
<form
  action="/sell-your-car"
  method="get"
  class="group mx-auto flex w-full max-w-[490px] h-14 sm:h-[60px] items-center overflow-hidden rounded-full bg-white transition-all duration-300 focus-within:ring-4 focus-within:ring-brand/20"
>
  <!-- EU Plate Strip -->
  <div class="flex h-full w-9 sm:w-[34px] shrink-0 flex-col items-center justify-center gap-0.5 rounded-l-full bg-[#003399] py-1 select-none">
    <!-- 12 Golden EU Stars -->
    <svg viewBox="0 0 24 24" class="size-3.5 sm:size-4 text-[#ffcc00]" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="3" r="1.1"/>
      <circle cx="16.5" cy="4.2" r="1.1"/>
      <circle cx="19.8" cy="7.5" r="1.1"/>
      <circle cx="21" cy="12" r="1.1"/>
      <circle cx="19.8" cy="16.5" r="1.1"/>
      <circle cx="16.5" cy="19.8" r="1.1"/>
      <circle cx="12" cy="21" r="1.1"/>
      <circle cx="7.5" cy="19.8" r="1.1"/>
      <circle cx="4.2" cy="16.5" r="1.1"/>
      <circle cx="3" cy="12" r="1.1"/>
      <circle cx="4.2" cy="7.5" r="1.1"/>
      <circle cx="7.5" cy="4.2" r="1.1"/>
    </svg>
    <span class="text-[11px] sm:text-[12px] font-black leading-none tracking-wider text-white">E</span>
  </div>

  <!-- Plate Number Input -->
  <input
    name="plate"
    type="text"
    placeholder="0000 ABC"
    maxlength="10"
    autocomplete="off"
    spellcheck="false"
    aria-label="License plate number"
    class="min-w-0 flex-1 bg-transparent px-5 text-lg sm:text-2xl font-medium uppercase text-navy outline-none placeholder:text-[#c4cedb] placeholder:font-medium"
  />

  <!-- CTA Button -->
  <button
    type="submit"
    class="inline-flex py-2 shrink-0 items-center gap-2 sm:gap-3 rounded-full bg-brand pl-4 sm:pl-5 pr-1.5 sm:pr-2 text-[13px] sm:text-base font-bold text-white transition-all duration-200 hover:bg-brand-dark hover:shadow-md active:scale-[0.98] cursor-pointer mr-1"
  >
    <span>Get My Valuation</span>
    <span class="grid size-8 sm:size-9 place-items-center rounded-full bg-white text-navy transition-transform duration-200 group-hover:translate-x-0.5">
      <Icon name="lucide:arrow-up-right" class="size-4 sm:size-4.5 stroke-[2.5]" />
    </span>
  </button>
</form>
