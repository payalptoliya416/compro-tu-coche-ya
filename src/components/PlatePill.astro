---
import { Icon } from 'astro-icon/components';
---
<form
  action="/sell-your-car"
  method="get"
  class="group mx-auto flex w-full max-w-[490px] h-12 sm:h-[60px] items-center overflow-hidden rounded-full bg-white transition-all duration-300"
>
  <!-- EU Plate Strip -->
  <div class="flex h-full w-8 sm:w-[34px] shrink-0 flex-col items-center justify-center gap-0.5 rounded-l-full bg-[#003399] py-1 select-none">
    <!-- 12 Golden EU Stars -->
    <svg viewBox="0 0 24 24" class="size-3 sm:size-4 text-[#ffcc00]" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="3" r="1.1"/>
      <circle cx="16.5" cy="4.2" r="1.1"/>
      <circle cx="19.8" cy="7.5" r="1.1"/>
      <circle cx="21" cy="12" r="1.1"/>
      <circle cx="19.8" cy="16.5" r="1.1"/>
      <circle cx="16.5" cy="19.8" r="1.1"/>
      <circle cx="12" cy="21" r="1.1"/>
      <circle cx="7.5" cy="19.8" r="1.1"/>
      <circle cx="4.2" cy="16.5" r="1.1"/>
      <circle cx="3" cy="12" r="1.1"/>
      <circle cx="4.2" cy="7.5" r="1.1"/>
      <circle cx="7.5" cy="4.2" r="1.1"/>
    </svg>
    <span class="text-[10px] sm:text-[12px] font-semibold leading-none tracking-wider text-white font-poppins">E</span>
  </div>

  <!-- Plate Number Input -->
  <input
    name="plate"
    type="text"
    placeholder="0000 ABC"
    maxlength="10"
    autocomplete="off"
    spellcheck="false"
    aria-label="License plate number"
    class="min-w-0 flex-1 bg-transparent px-2.5 sm:px-5 text-sm sm:text-2xl font-medium uppercase text-navy outline-none placeholder:text-[#c4cedb] placeholder:font-medium placeholder:text-sm sm:placeholder:text-2xl"
  />

  <!-- CTA Button -->
  <button
    type="submit"
    class="inline-flex py-1.5 sm:py-2 shrink-0 items-center gap-1.5 sm:gap-3 rounded-full bg-brand pl-3 sm:pl-5 pr-1.5 sm:pr-2 text-xs sm:text-base font-medium text-white transition-all duration-200 hover:bg-brand-dark hover:shadow-md active:scale-[0.98] cursor-pointer mr-1"
  >
    <span class="whitespace-nowrap">Get My Valuation</span>
    <span class="grid size-7 sm:size-9 place-items-center rounded-full bg-white text-[#02214A] shrink-0 transition-transform duration-200 group-hover:translate-x-0.5">
      <svg width="18" height="1819" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-3.5 sm:size-[18]">
        <path d="M3.46155 15L15 3.46155M15 12.1154V3.46155H6.34616" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </button>
</form>
