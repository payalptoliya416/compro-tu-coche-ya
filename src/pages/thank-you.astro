---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';

const details = [
  ['car_number', 'License plate', 'lucide:car-front'],
  ['car_details', 'Vehicle', 'lucide:car'],
  ['year', 'Year', 'lucide:calendar-days'],
  ['version', 'Version', 'lucide:settings-2'],
  ['car_location', 'Car location', 'lucide:map-pin'],
  ['milage', 'Mileage', 'lucide:gauge'],
  ['expected_selling_price', 'Expected selling price', 'lucide:banknote'],
];
const contactDetails = [
  ['full_name', 'Full name', 'lucide:user-round'],
  ['phone_number', 'Phone number', 'lucide:phone'],
  ['email', 'Email address', 'lucide:mail'],
];
---
<Layout title="Thank you" description="Thank you for submitting your car valuation request. Our team will review your vehicle details and get in touch.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <style is:inline>
      html:not([data-receipt-access]) body { visibility: hidden; }
    </style>
    <script is:inline>
      
      try {
        const cookies = document.cookie.split(';').map((value) => value.trim());
        const read = (name) => {
          const cookie = cookies.find((value) => value.startsWith(`${name}=`));
          return cookie ? cookie.slice(name.length + 1) : '';
        };
        const permit = JSON.parse(decodeURIComponent(read('car_valuation_receipt')));
        if (!Number.isFinite(permit.expires_at) || permit.expires_at <= Date.now()
            || !Number.isInteger(permit.parts) || permit.parts < 1 || permit.parts > 8) throw new Error();
        let encoded = '';
        for (let i = 0; i < permit.parts; i++) {
          const part = read(`car_valuation_receipt_part_${i}`);
          if (!part) throw new Error();
          encoded += part;
        }
        const receipt = JSON.parse(decodeURIComponent(encoded));
        if (typeof receipt.car_number !== 'string' || !receipt.car_number.trim()) throw new Error();
        document.documentElement.setAttribute('data-receipt-access', '');
      } catch {
        window.location.replace('/');
      }
    </script>
  </Fragment>
  <section class="px-3 sm:px-[30px]">
    <div class="relative isolate overflow-hidden rounded-[26px] bg-surface px-4 py-12 sm:px-8 sm:py-16 lg:py-20">
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-32 -z-10 size-96 rounded-full bg-brand/5"></div>
      <div class="mx-auto grid max-w-[1120px] items-start gap-8 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
        <div class="text-center lg:pt-6 lg:text-left">
          <div class="mx-auto mb-6 flex size-20 items-center justify-center rounded-full border-8 border-white bg-brand text-white shadow-sm lg:mx-0">
            <Icon name="lucide:check" class="size-9" />
          </div>
          <span class="text-xs font-medium uppercase tracking-[0.15em] text-brand">Submission received</span>
          <h1 class="mt-3 text-3xl font-medium leading-tight text-navy sm:text-[42px]">Thank you for<br class="hidden sm:block" /> your submission!</h1>
          <div class="mt-7 rounded-2xl border border-line bg-white/70 p-5 text-left">
            <div class="flex items-center gap-3 text-navy">
              <Icon name="lucide:message-circle" class="size-5 shrink-0 text-brand" />
              <h2 class="font-medium">What happens next?</h2>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">We’ll review the information and photos you shared, then contact you using the details in your request. There’s nothing else you need to do right now.</p>
          </div>
          <div class="mt-6 rounded-2xl border border-line bg-white p-5 text-left sm:p-6">
            <h2 class="text-lg font-medium text-navy">Your contact details</h2>
            <dl class="mt-3 divide-y divide-line">
              {contactDetails.map(([key, label, icon]) => (
                <div class="flex items-start justify-between gap-4 py-3">
                  <dt class="flex items-center gap-2 text-xs text-muted sm:text-sm"><Icon name={icon} class="size-4 shrink-0" />{label}</dt>
                  <dd data-receipt-field={key} class="min-w-0 max-w-[60%] break-words text-right text-sm font-medium text-navy">—</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="mt-7"><Button href="/" class="w-full sm:w-auto">Back to home</Button></div>
        </div>

        <div class="min-w-0 rounded-[22px] border border-line bg-white p-5 shadow-sm sm:p-8">
          <div class="flex items-center gap-3 border-b border-line pb-5">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"><Icon name="lucide:car-front" class="size-6" /></span>
            <div><h2 class="text-xl font-medium text-navy">Your vehicle details</h2><p class="mt-1 text-xs text-muted">A summary of your valuation request</p></div>
          </div>
          <div id="receipt-details" hidden>
            <dl class="divide-y divide-line">
              {details.map(([key, label, icon]) => (
                <div class="flex items-start justify-between gap-4 py-4">
                  <dt class="flex items-center gap-2 text-xs text-muted sm:text-sm"><Icon name={icon} class="size-4 shrink-0" />{label}</dt>
                  <dd data-receipt-field={key} class="min-w-0 max-w-[55%] break-words text-right text-sm font-medium text-navy">—</dd>
                </div>
              ))}
            </dl>
            <div class="mt-1 rounded-xl bg-surface p-4">
              <h3 class="text-xs font-medium text-muted">Vehicle condition &amp; document status</h3>
              <p data-receipt-field="condition_document_status" class="mt-2 whitespace-pre-wrap break-words text-sm leading-relaxed text-navy"></p>
            </div>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs text-muted"><Icon name="lucide:shield-check" class="size-4 shrink-0 text-brand" />Free assessment · No commitment</div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { consumeVehicleReceipt, type VehicleReceipt } from '../scripts/valuation-receipt';

  const receipt = consumeVehicleReceipt();
  if (receipt) {
    document.querySelectorAll<HTMLElement>('[data-receipt-field]').forEach((element) => {
      const key = element.dataset.receiptField as keyof VehicleReceipt;
      let value = receipt[key] || 'Not provided';
      if (key === 'phone_number') {
        value = [receipt.country_code, receipt.phone_number].filter(Boolean).join(' ') || 'Not provided';
      }
      if (key === 'expected_selling_price' && receipt[key]) {
        value = `€ ${receipt[key]}`;
      }
      if (key === 'milage' && /^\d+(?:\s*km)?$/i.test(receipt[key])) {
        value = `${new Intl.NumberFormat('en-GB').format(Number.parseInt(receipt[key], 10))} km`;
      }
      element.textContent = value;
    });
    const details = document.getElementById('receipt-details');
    if (details) details.hidden = false;
  } else {
    document.documentElement.removeAttribute('data-receipt-access');
    window.location.replace('/');
  }
  
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) window.location.replace('/');
  });
</script>
