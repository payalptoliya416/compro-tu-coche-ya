---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
import StepsCircle from '../sections/StepsCircle.astro';
import SpainMap from '../sections/SpainMap.astro';
import Faq from '../sections/Faq.astro';
import { images } from '../data/images';
import { pickupSteps } from '../data/site';

const perks = [
  ['lucide:map-pin', 'Anywhere in Spain', 'We cover all provinces and territories across Spain.'],
  ['lucide:clock', 'Convenient Pickup Times', 'Morning, afternoon or weekend - you choose the slot.'],
  ['lucide:wallet', 'No Extra Pickup Cost', 'Vehicle collection is 100% free, no hidden charges.'],
];
const places = [
  [images.pickupCity, 'City Pickup', 'Pickup from urban locations, streets, parking lots or city centres across Spain.'],
  [images.pickupHome, 'Home Pickup', 'We collect directly from your home - no need to travel anywhere.'],
  [images.pickupWork, 'Workplace Pickup', "Convenient collection from your workplace so you don't lose a working day."],
];
const experience = [
  ['lucide:users', 'Professional Collection Team', 'Trained specialists handle your vehicle with care.'],
  ['lucide:calendar', 'Flexible Scheduling', 'Mornings, afternoons, evenings or weekends.'],
  ['lucide:shield-check', 'Safe Vehicle Handover', 'Fully documented transfer with legal protection.'],
  ['lucide:message-circle', 'Clear Communication', 'Constant updates before and during pickup.'],
  ['lucide:tag', 'No Hidden Pickup Fees', 'Collection is always 100% free, no exceptions.'],
];
---
<Layout title="Easy Pickup">
  <PageHero image={images.heroPickup} badge="Easy Vehicle Pickup" title="We Pick Up Your Car {Anywhere in Spain.}" text="Sell your car without worrying about transport. We collect your vehicle directly from your location at a time that suits you.">
    <Button href="/lets-talk">Arrange My Pickup</Button>
  </PageHero>

  <Section>
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="h2">Your Car, Our Pickup.</h2>
        <p class="mt-3 max-w-md text-[13px] leading-relaxed text-muted">Wherever your car is in Spain, we make collection simple and convenient. No logistics stress - just a smooth, professional pickup experience.</p>
        <ul class="mt-5 space-y-3">
          {perks.map(([i, t, s]) => (
            <li class="flex items-start gap-3">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand/10 text-brand"><Icon name={i} class="size-3.5" /></span>
              <span class="leading-tight"><span class="block text-[13px] font-semibold text-navy">{t}</span><span class="text-[12px] text-muted">{s}</span></span>
            </li>
          ))}
        </ul>
        <div class="mt-6"><Button href="/lets-talk" size="sm">Check Pickup Availability</Button></div>
      </div>
      <SpainMap />
    </div>
  </Section>

  <StepsCircle title="How Pickup Works" text="From booking to handover, we make the entire collection process seamless and stress-free." steps={pickupSteps} />

  <section class="frame">
    <div class="rounded-3xl bg-navy py-12 text-white md:py-16">
      <div class="wrap">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <h2 class="text-2xl font-bold md:text-[32px]">We Come to You</h2>
          <p class="mt-2 text-sm text-white/70">Choose where to meet us. We adapt to your schedule and location.</p>
        </div>
        <ul class="grid gap-4 md:grid-cols-3">
          {places.map(([img, t, s]) => (
            <li class="rounded-xl border border-white/10 bg-white/5 p-3">
              <img src={img} alt={t} class="aspect-[4/3] w-full rounded-lg object-cover" loading="lazy" />
              <h3 class="mt-4 px-1 text-[15px] font-semibold">{t}</h3>
              <p class="mt-1 px-1 pb-2 text-[12.5px] text-white/70">{s}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Section>
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_1fr]">
      <img src={images.pickupWoman} alt="" class="aspect-[4/4.2] w-full rounded-xl object-cover" loading="lazy" />
      <div>
        <h2 class="h2">A Pickup Experience <span class="text-brand">Without the Hassle</span></h2>
        <ul class="mt-5 space-y-3.5">
          {experience.map(([i, t, s]) => (
            <li class="flex items-start gap-3">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand/10 text-brand"><Icon name={i} class="size-3.5" /></span>
              <span class="leading-tight"><span class="block text-[13px] font-semibold text-navy">{t}</span><span class="text-[12px] text-muted">{s}</span></span>
            </li>
          ))}
        </ul>
        <div class="mt-6"><Button href="/lets-talk" size="sm">Arrange My Pickup</Button></div>
      </div>
    </div>
  </Section>

  <Faq />
</Layout>
