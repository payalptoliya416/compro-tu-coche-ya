---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Section from '../components/Section.astro';
import StepsCircle from '../sections/StepsCircle.astro';
import SpainMap from '../sections/SpainMap.astro';
import Faq from '../sections/Faq.astro';
import { images } from '../data/images';
import { pickupSteps } from '../data/site';

const perks = [
  ['lucide:map-pin', 'Anywhere in Spain', 'We cover all provinces and territories across Spain.'],
  ['lucide:clock', 'Convenient Pickup Times', 'Morning, afternoon or weekend - you choose the slot.'],
  ['lucide:wallet', 'No Extra Pickup Cost', 'Vehicle collection is 100% free, no hidden charges.'],
];
const places = [
  ['/images/meet01.png', 'City Pickup', 'Pickup from urban locations, streets, parking lots or city centres across Spain.'],
  ['/images/meet02.png', 'Home Pickup', 'We collect directly from your home - no need to travel anywhere.'],
  ['/images/meet03.png', 'Workplace Pickup', "Convenient collection from your workplace so you don't lose a working day."],
];
const experience = [
  ['lucide:users', 'Professional Collection Team', 'Trained specialists handle your vehicle with care.'],
  ['lucide:calendar', 'Flexible Scheduling', 'Mornings, afternoons, evenings or weekends.'],
  ['lucide:shield-check', 'Safe Vehicle Handover', 'Fully documented transfer with legal protection.'],
  ['lucide:message-circle', 'Clear Communication', 'Constant updates before and during pickup.'],
  ['lucide:tag', 'No Hidden Pickup Fees', 'Collection is always 100% free, no exceptions.'],
];
---
<Layout title="Easy Pickup">
  <section class="p-3.5 sm:p-5 md:p-[30px]">
    <div class="relative isolate overflow-hidden rounded-[26px] bg-navy-deep text-white h-[600px] sm:h-[650px] md:h-[680px] flex items-center justify-center">
      <img src="/images/easy-bg.png" alt="" class="absolute inset-0 -z-20 size-full object-cover object-center" />
      <div class="wrap flex flex-col items-center justify-center py-12 text-center">
        <Badge>Easy Vehicle Pickup</Badge>
        <h1 class="max-w-4xl text-[30px] font-medium leading-[1.2] tracking-tight sm:text-[40px] md:text-[52px]">
          We Pick Up Your Car <span class="text-brand">Anywhere in Spain.</span>
        </h1>
        <p class="mt-4 max-w-2xl text-sm font-light leading-relaxed text-white/90 sm:text-base">
          Sell your car without worrying about transport. We collect your vehicle directly from your location at a time that suits you.
        </p>
        <div class="mt-[35px] flex items-center justify-center">
          <Button href="/lets-talk" variant="primary" size="sm">Arrange My Pickup</Button>
        </div>
      </div>
    </div>
  </section>

  <Section>
    <div class="grid items-center gap-[30px] lg:grid-cols-2">
      <div>
        <h2 class="h2">Your Car, Our Pickup.</h2>
        <p class="mt-6 space-y-4 text-base leading-relaxed text-[#677A92] w-full max-w-[560px]">Wherever your car is in Spain, we make collection simple and convenient. No logistics stress - just a smooth, professional pickup experience.</p>
        <ul class="mt-5 space-y-[25px]">
          {perks.map(([i, t, s]) => (
            <li class="flex items-start gap-[10px]">
              <span class="grid size-[46px] shrink-0 place-items-center rounded-full bg-brand/5 text-brand"><Icon name={i} class="size-4" /></span>
              <span class="leading-tight"><span class="block text-base text-navy mb-1">{t}</span><span class="text-base text-[#9AA6B7]">{s}</span></span>
            </li>
          ))}
        </ul>
        <div class="mt-6"><Button href="/lets-talk" size="sm">Check Pickup Availability</Button></div>
      </div>
      <SpainMap />
    </div>
  </Section>

  <StepsCircle title="How Pickup Works" text="From booking to handover, we make the entire collection process seamless and stress-free." steps={pickupSteps} />

  <section class="p-[30px]">
    <div class="rounded-[26px] bg-[#02214A] text-white py-[110px]">
      <div class="wrap">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <h2 class="h2 !text-white">We Come to You</h2>
          <p class="lead mt-3 !text-[#B3BCC9]">Choose where to meet us. We adapt to your schedule and location.</p>
        </div>
        <ul class="grid gap-6 md:grid-cols-3">
          {places.map(([img, t, s]) => (
            <li class="rounded-[18px] border border-white/40 bg-white/10 p-4 sm:p-[30px]">
              <img src={img} alt={t} class="" loading="lazy" />
              <h3 class="mt-[25px] text-xl font-medium text-white">{t}</h3>
              <p class="mt-[15px] text-lg leading-relaxed text-[#B3BCC9]">{s}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Section>
    <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_1fr]">
      <img src="/images/pickup.png" alt="" class="" loading="lazy" />
      <div>
        <h2 class="h2">A Pickup Experience <span class="text-brand">Without the Hassle</span></h2>
        <ul class="mt-[25px] space-y-[25px]">
          {experience.map(([i, t, s]) => (
            <li class="flex items-start gap-[10px]">
              <span class="grid size-[46px] shrink-0 place-items-center rounded-full bg-brand/5 text-brand"><Icon name={i} class="size-4" /></span>
              <span class="leading-tight"><span class="block text-base text-navy mb-1">{t}</span><span class="text-base text-[#9AA6B7]">{s}</span></span>
            </li>
          ))}
        </ul>
        <div class="mt-6"><Button href="/lets-talk" size="sm">Arrange My Pickup</Button></div>
      </div>
    </div>
  </Section>

  <Faq />
</Layout>
