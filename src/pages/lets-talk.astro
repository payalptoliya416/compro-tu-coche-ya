---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Section from '../components/Section.astro';
import SpainMap from '../sections/SpainMap.astro';
import Testimonials from '../sections/Testimonials.astro';
import Faq from '../sections/Faq.astro';
import { images } from '../data/images';

const side = [['lucide:zap', 'Quick Response'], ['lucide:smile', 'Friendly Support'], ['lucide:circle-help', 'Clear Answers']];
const across = [
  ['lucide:map-pin', 'Nationwide Support', 'We cover all regions and cities across Spain.'],
  ['lucide:phone', 'Easy Communication', 'Call, email or message us - we are always available.'],
  ['lucide:car', 'Vehicle Pickup Available', 'We come to you, wherever you are in Spain.'],
];
const field = 'h-12 w-full rounded-full border border-[#CCD3DB] bg-white px-4 text-base text-navy outline-none transition-colors placeholder:text-[#9AA6B7]';
---
<Layout title="Let's talk">
  <section class="px-4 md:px-[30px]">
    <div class="relative isolate overflow-hidden rounded-[26px] bg-navy-deep text-white h-[440px] sm:h-[520px] md:h-[600px] lg:h-[680px] flex items-center justify-center">
      <img src={images.letsTalkBg} alt="" class="absolute inset-0 -z-20 size-full object-cover object-center" />
      <div class="absolute inset-0 -z-10 bg-black/50"></div>
      <div class="wrap flex flex-col items-center justify-center py-12 text-center">
        <Badge>Let's Talk</Badge>
        <h1 class="max-w-4xl text-[30px] font-medium leading-[1.2] tracking-tight sm:text-[40px] md:text-[52px]">
          How Can We <span class="text-brand">Help You?</span>
        </h1>
        <p class="mt-4 max-w-2xl text-sm font-light leading-relaxed text-white/90 sm:text-base">
          Have a question about selling your car? Our team is ready to help you with the process.
        </p>
        <div class="mt-[35px] flex flex-wrap items-center justify-center gap-4">
          <Button href="/sell-your-car" variant="primary" size="sm">Sell Your Car</Button>
          <Button href="#contact-form" variant="white" size="sm">Contact Our Team</Button>
        </div>
      </div>
    </div>
  </section>

  <Section>
    <div class="mx-auto grid max-w-[1310px] gap-5 lg:grid-cols-[1.5fr_1fr]">
      <form id="contact-form" novalidate class="rounded-[18px] bg-white border border-[#E6E9ED] p-5 xl:p-10">
        <h2 class="text-2xl font-medium text-[#02214A]">Tell Us What You Need</h2>
        <p class="mt-[15px] text-base text-[#677A92]">Send us your details and our team will get back to you shortly.</p>
        
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          <!-- First Name -->
          <div>
            <label for="first-name" class="block text-base text-[#354D6E]">First Name</label>
            <input id="first-name" name="first" placeholder="Enter your first name" class={`${field} mt-1.5`} />
            <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
          </div>

          <!-- Last Name -->
          <div>
            <label for="last-name" class="block text-base text-[#354D6E]">Last Name</label>
            <input id="last-name" name="last" placeholder="Enter your last name" class={`${field} mt-1.5`} />
            <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-base text-[#354D6E]">Phone</label>
            <div class="phone-pill mt-1.5 flex h-12 w-full items-center rounded-full border border-[#CCD3DB] bg-white transition-colors overflow-hidden">
              <select id="phone-code" name="phone_code" aria-label="Country code" class="h-full shrink-0 cursor-pointer appearance-none border-0 bg-transparent pl-4 pr-1 text-base text-navy outline-none">
                <option value="+34">🇪🇸 +34</option>
                <option value="+44">🇬🇧 +44</option>
                <option value="+33">🇫🇷 +33</option>
                <option value="+49">🇩🇪 +49</option>
                <option value="+39">🇮🇹 +39</option>
                <option value="+351">🇵🇹 +351</option>
                <option value="+1">🇺🇸 +1</option>
                <option value="+52">🇲🇽 +52</option>
                <option value="+54">🇦🇷 +54</option>
                <option value="+57">🇨🇴 +57</option>
                <option value="+56">🇨🇱 +56</option>
              </select>
              <span class="h-5 w-px bg-[#CCD3DB] shrink-0"></span>
              <input id="phone" name="phone" type="tel" placeholder="000 000 000" class="h-full flex-1 bg-transparent px-3 text-base text-navy outline-none placeholder:text-[#9AA6B7]" />
            </div>
            <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
          </div>

          <!-- Email Address -->
          <div>
            <label for="email" class="block text-base text-[#354D6E]">Email Address</label>
            <input id="email" name="email" type="email" placeholder="Enter your email address" class={`${field} mt-1.5`} />
            <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
          </div>
        </div>

        <!-- How can we help you -->
        <div class="mt-5">
          <label for="topic" class="block text-base text-[#354D6E]">How can we help you?</label>
          <div class="relative">
            <select id="topic" name="topic" class={`${field} mt-1.5 appearance-none cursor-pointer pr-9`}>
              <option value="" disabled selected>Select an option</option>
              <option value="sell">I want to sell my car</option>
              <option value="pickup">Pickup question</option>
              <option value="valuation">Valuation inquiry</option>
              <option value="other">Something else</option>
            </select>
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[#9AA6B7]">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5.5L7 9.5L11 5.5"/></svg>
            </span>
          </div>
          <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
        </div>

        <!-- Message -->
        <div class="mt-5">
          <label for="message" class="block text-base text-[#354D6E]">Message</label>
          <textarea id="message" name="message" rows="4" placeholder="Tell us about your car or question..." class={`${field} mt-1.5 h-[134px] resize-none py-2.5 !rounded-[12px]`}></textarea>
          <p class="error-msg mt-1.5 text-xs text-red-500 hidden"></p>
        </div>

        <!-- Success Notification -->
        <div id="form-success" class="mt-5 hidden rounded-xl bg-green-50 border border-green-200 p-4 text-center text-sm font-medium text-green-800">
          ✓ Thank you! Your message has been sent successfully. Our team will get back to you shortly.
        </div>

        <button type="submit" class="mt-8 h-12 w-full rounded-full bg-brand text-lg font-medium text-white transition-colors hover:bg-brand-dark cursor-pointer">Send Message</button>
        <p class="mt-[15px] text-center text-sm sm:text-base text-[#677A92]">Your information is safe and will only be used to respond to your request.</p>
      </form>

      <aside class="relative isolate flex min-h-[420px] overflow-hidden rounded-[18px] text-white">
        <img src="/images/tell-us.png" alt="" class="absolute inset-0 -z-20 size-full object-cover object-top lg:object-center" />
        <div class="absolute inset-0 -z-10 bg-black/50 lg:hidden"></div>
        <div class="mt-auto p-[25px]">
          <h3 class="text-xl font-medium">We're Here to Help</h3>
          <p class="mt-[10px] text-base text-white">Whether you're ready to sell your car or simply have a question, our team is here to guide you.</p>
          <ul class="mt-[30px] space-y-5">
            {side.map(([i, t]) => (
              <li class="flex items-center gap-[10px] text-lg"><span class="grid size-[34px] place-items-center rounded-[10px] bg-[#FD570F]/20 text-brand"><Icon name={i} class="size-3.5" /></span>{t}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <Section class="!pt-0">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="h2">We're Here Across Spain</h2>
        <p class="mt-6 space-y-4 text-base leading-relaxed text-[#677A92] w-full max-w-[560px]">Our team supports customers throughout Spain, making selling your car simple wherever you are.</p>
        <ul class="mt-5 space-y-[25px]">
          {across.map(([i, t, s]) => (
            <li class="flex items-start gap-[10px]">
              <span class="grid size-[46px] shrink-0 place-items-center rounded-full bg-brand/5 text-brand"><Icon name={i} class="size-4" /></span>
              <span class="leading-tight"><span class="block text-base text-navy mb-1">{t}</span><span class="text-base text-[#9AA6B7]">{s}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <SpainMap />
    </div>
  </Section>

  <Testimonials gray />
  <Faq />
</Layout>

<script>
  function setupContactValidation() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const phoneInput = form.querySelector<HTMLInputElement>('#phone');

    const fields = {
      first: {
        input: form.querySelector<HTMLInputElement>('#first-name'),
        validate: (val: string) => (val.trim().length > 0 ? '' : 'Please enter your first name.'),
      },
      last: {
        input: form.querySelector<HTMLInputElement>('#last-name'),
        validate: (val: string) => (val.trim().length > 0 ? '' : 'Please enter your last name.'),
      },
      phone: {
        input: phoneInput,
        validate: (val: string) => {
          if (!val.trim()) return 'Please enter your phone number.';
          const digits = val.replace(/\D/g, '');
          if (digits.length < 6) return 'Please enter a valid phone number.';
          return '';
        },
      },

      email: {
        input: form.querySelector<HTMLInputElement>('#email'),
        validate: (val: string) => {
          if (!val.trim()) return 'Please enter your email address.';
          const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!regex.test(val.trim())) return 'Please enter a valid email address.';
          return '';
        },
      },
      topic: {
        input: form.querySelector<HTMLSelectElement>('#topic'),
        validate: (val: string) => (val ? '' : 'Please select how we can help you.'),
      },
      message: {
        input: form.querySelector<HTMLTextAreaElement>('#message'),
        validate: (val: string) => (val.trim().length > 0 ? '' : 'Please enter your message.'),
      },
    };

    function showError(el: HTMLElement | null, msg: string) {
      if (!el) return;
      const pill = el.closest('.phone-pill');
      if (pill) {
        pill.classList.add('!border-red-500');
      } else {
        el.classList.add('!border-red-500');
      }
      const container = el.closest('div');
      const errEl = container ? container.querySelector<HTMLElement>('.error-msg') : null;
      if (errEl) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      }
    }

    function clearError(el: HTMLElement | null) {
      if (!el) return;
      const pill = el.closest('.phone-pill');
      if (pill) {
        pill.classList.remove('!border-red-500');
      } else {
        el.classList.remove('!border-red-500');
      }
      const container = el.closest('div');
      const errEl = container ? container.querySelector<HTMLElement>('.error-msg') : null;
      if (errEl) {
        errEl.textContent = '';
        errEl.classList.add('hidden');
      }
    }

    // Clear error dynamically when typing or selecting
    Object.values(fields).forEach(({ input }) => {
      if (!input) return;
      input.addEventListener('input', () => clearError(input));
      input.addEventListener('change', () => clearError(input));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let hasError = false;
      let firstInvalid: HTMLElement | null = null;

      Object.values(fields).forEach(({ input, validate }) => {
        if (!input) return;
        const error = validate(input.value);
        if (error) {
          showError(input, error);
          hasError = true;
          if (!firstInvalid) firstInvalid = input;
        } else {
          clearError(input);
        }
      });

      if (hasError) {
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      // Show success notification
      const successEl = document.getElementById('form-success');
      if (successEl) {
        successEl.classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          successEl.classList.add('hidden');
        }, 5000);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactValidation);
  } else {
    setupContactValidation();
  }
  document.addEventListener('astro:page-load', setupContactValidation);
</script>
