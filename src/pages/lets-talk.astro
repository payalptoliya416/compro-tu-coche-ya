---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SpainMap from '../sections/SpainMap.astro';
import Testimonials from '../sections/Testimonials.astro';
import Faq from '../sections/Faq.astro';
import { images } from '../data/images';

const side = [['lucide:zap', 'Quick Response'], ['lucide:smile', 'Friendly Support'], ['lucide:circle-help', 'Clear Answers']];
const across = [
  ['lucide:map-pin', 'Nationwide Support', 'We cover all regions and cities across Spain.'],
  ['lucide:phone', 'Easy Communication', 'Call, email or message us - we are always available.'],
  ['lucide:car', 'Vehicle Pickup Available', 'We come to you, wherever you are in Spain.'],
];
const field = 'h-11 w-full rounded-lg border border-line bg-white px-3 text-[13px] text-navy outline-none transition-colors placeholder:text-slate-400 focus:border-brand';
---
<Layout title="Let's talk">
  <PageHero image={images.heroContact} badge="Let's Talk" title="How Can We {Help You?}" text="Have a question about selling your car? Our team is ready to help you with the process.">
    <Button href="/sell-your-car">Sell Your Car</Button>
    <Button href="#contact-form" variant="white">Contact Our Team</Button>
  </PageHero>

  <Section>
    <div class="mx-auto grid max-w-[900px] gap-5 lg:grid-cols-[1.5fr_1fr]">
      <form id="contact-form" action="#" method="post" class="rounded-2xl bg-white p-5 shadow-[0_10px_40px_rgba(11,42,91,0.1)] sm:p-6">
        <h2 class="text-base font-semibold">Tell Us What You Need</h2>
        <p class="mt-1 text-xs text-muted">Send us your details and our team will get back to you shortly.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="block text-xs font-medium">First Name<input name="first" placeholder="Enter your first name" class={`${field} mt-1.5`} /></label>
          <label class="block text-xs font-medium">Last Name<input name="last" placeholder="Enter your last name" class={`${field} mt-1.5`} /></label>
          <div class="text-xs font-medium">
            <label for="phone">Phone</label>
            <div class="mt-1.5 flex gap-2">
              <select aria-label="Country code" class={`${field} !w-[74px] shrink-0 !px-2 text-slate-400`}><option>+00</option><option>+34</option><option>+44</option><option>+351</option></select>
              <input id="phone" name="phone" type="tel" placeholder="0000 000 000" class={field} />
            </div>
          </div>
          <label class="block text-xs font-medium">Email Address<input name="email" type="email" placeholder="Enter your email address" class={`${field} mt-1.5`} /></label>
        </div>
        <label class="mt-4 block text-xs font-medium">How can we help you?
          <select name="topic" class={`${field} mt-1.5 text-slate-400`}>
            <option>Select an option</option><option>I want to sell my car</option><option>Pickup question</option><option>Something else</option>
          </select>
        </label>
        <label class="mt-4 block text-xs font-medium">Message
          <textarea name="message" rows="4" placeholder="Tell us about your car or question..." class={`${field} mt-1.5 h-28 resize-none py-2.5`}></textarea>
        </label>
        <button type="submit" class="mt-5 h-11 w-full rounded-full bg-brand text-sm font-semibold text-white transition-colors hover:bg-brand-dark">Send Message</button>
        <p class="mt-3 text-center text-[11px] text-muted">Your information is safe and will only be used to respond to your request.</p>
      </form>

      <aside class="relative isolate flex min-h-[420px] overflow-hidden rounded-2xl bg-navy text-white">
        <img src={images.contactSide} alt="" class="absolute inset-0 -z-20 size-full object-cover" />
        <div class="absolute inset-0 -z-10 bg-linear-to-t from-navy via-navy/80 to-transparent"></div>
        <div class="mt-auto p-5">
          <h3 class="text-[15px] font-semibold">We're Here to Help</h3>
          <p class="mt-1.5 text-xs text-white/80">Whether you're ready to sell your car or simply have a question, our team is here to guide you.</p>
          <ul class="mt-4 space-y-2.5">
            {side.map(([i, t]) => (
              <li class="flex items-center gap-2.5 text-xs"><span class="grid size-6 place-items-center rounded-md bg-white/10 text-brand"><Icon name={i} class="size-3.5" /></span>{t}</li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Section>

  <Section class="!pt-0">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 class="h2">We're Here Across Spain</h2>
        <p class="mt-3 max-w-sm text-[13px] leading-relaxed text-muted">Our team supports customers throughout Spain, making selling your car simple wherever you are.</p>
        <ul class="mt-5 space-y-3">
          {across.map(([i, t, s]) => (
            <li class="flex items-start gap-3">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand/10 text-brand"><Icon name={i} class="size-3.5" /></span>
              <span class="leading-tight"><span class="block text-[13px] font-semibold text-navy">{t}</span><span class="text-[12px] text-muted">{s}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <SpainMap />
    </div>
  </Section>

  <Testimonials gray />
  <Faq />
</Layout>
