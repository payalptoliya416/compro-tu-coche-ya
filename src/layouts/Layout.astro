---
import '../styles/global.css';
import 'swiper/css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description = 'Sell your car fast, easy and at the best price in Spain.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <slot name="head" />
    {Astro.url.pathname === '/' && (
      <style is:inline>
        html[data-valuation-pending] #hero-state-initial {
          display: none !important;
        }
        html[data-valuation-pending] #hero-state-form {
          display: grid !important;
        }
      </style>
      <script is:inline>
        try {
          const cookie = document.cookie.split(';').map((value) => value.trim())
            .find((value) => value.startsWith('car_valuation_pending_plate='));
          const plate = cookie ? decodeURIComponent(cookie.slice(cookie.indexOf('=') + 1)) : '';
          if (plate.trim() || new URLSearchParams(location.search).get('plate')?.trim()) {
            document.documentElement.setAttribute('data-valuation-pending', '');
          }
        } catch {
          
        }
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Compro Tu Coche Ya</title>

    <style is:global>
      /* Ensure direct Spanish display: never show English while translating */
      html.translating-es:not(.translated-ltr) body {
        opacity: 0 !important;
        visibility: hidden !important;
      }
      body {
        opacity: 1;
        transition: opacity 0.2s ease-in;
      }
    </style>

    <script is:inline>
      (function () {
        var lang = localStorage.getItem('site_lang');
        if (!lang) {
          lang = 'es';
          localStorage.setItem('site_lang', 'es');
        }
        document.documentElement.lang = lang;

        if (lang === 'es') {
          document.documentElement.classList.add('translating-es');
          document.cookie = 'googtrans=/en/es; path=/;';
        } else {
          document.documentElement.classList.remove('translating-es');
          document.cookie = 'googtrans=/en/en; path=/;';
          document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        }

        // Safety fallback: in case of offline/network block, reveal after 2s
        setTimeout(function () {
          document.documentElement.classList.remove('translating-es');
        }, 2000);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <!-- Google Translate Dynamic Integration (Loaded early at top of body) -->
    <div id="google_translate_element" style="position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden;" class="notranslate" translate="no"></div>
    <script is:inline type="text/javascript">
      function googleTranslateElementInit() {
        new window.google.translate.TranslateElement({
          pageLanguage: 'en',
          includedLanguages: 'es,en',
          autoDisplay: false
        }, 'google_translate_element');
      }
    </script>
    <script is:inline type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <Header />
    <main><slot /></main>
    <Footer />
    <script>
      import '../scripts/plate-navigation';
    </script>
  </body>
</html>
