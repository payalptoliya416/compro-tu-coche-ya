---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { testimonials } from '../data/site';
const { gray = false } = Astro.props;
---
<Section gray={gray}>
  <SectionTitle title="Our customers say so." text="Hundreds of customers have already sold their car with us." />

  <div class="swiper testimonials-swiper">
    <div class="swiper-wrapper">
      {testimonials.map((t) => (
        <div class="swiper-slide h-auto">
          <figure class="h-full rounded-[18px] bg-white px-5 pt-7 pb-[30px]">
            <div class="flex items-start justify-between">
              <img src="/images/invert.png" alt="" class="" />
              <div class="flex gap-0.5">
                {[0,1,2,3,4].map(() =>  <img src="/images/star.svg" alt="" class="" />)}
              </div>
            </div>
            <blockquote class="mt-[15px] text-sm leading-relaxed text-[#677A92]">"{t.text}"</blockquote>
            <figcaption class="mt-9 flex items-center gap-[10px]">
              <img src={t.avatar} alt={t.name} class="size-[44px] rounded-full object-cover" />
              <span class="leading-tight">
                <span class="block text-base text-[#02214A] mb-0.5">{t.name}</span>
                <span class="text-sm text-[#677A92]">{t.city}</span>
              </span>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
    <div class="flex justify-center items-center pt-5">
      <div class="swiper-pagination testimonials-pagination "></div>
    </div>
  </div>
</Section>

<style>
  .testimonials-swiper {
    padding-bottom: 2.5rem !important;
  }

  /* Dot base */
  .testimonials-pagination :global(.swiper-pagination-bullet) {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #cbd5e1;
    opacity: 1;
    margin: 0 4px;
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  /* Active dot */
  .testimonials-pagination :global(.swiper-pagination-bullet-active) {
    width: 22px;
    background-color: #e8380d;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination } from 'swiper/modules';

  new Swiper('.testimonials-swiper', {
    modules: [Pagination],
    slidesPerView: 1,
    spaceBetween: 16,
    grabCursor: true,
    speed: 400,
    pagination: {
      el: '.testimonials-swiper .testimonials-pagination',
      clickable: true,
    },
    breakpoints: {
      640: { slidesPerView: 2, spaceBetween: 20 },
      1024: { slidesPerView: 3, spaceBetween: 24 },
    },
  });
</script>
