---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { testimonials } from '../data/site';
const { gray = false } = Astro.props;
---
<Section gray={gray}>
  <SectionTitle title="Our customers say so." text="Hundreds of customers have already sold their car with us." />
  <div class="no-scrollbar -mx-4 flex snap-x gap-4 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
    {testimonials.map((t) => (
      <figure class="min-w-[85%] snap-center rounded-xl border border-line bg-white p-5 shadow-sm sm:min-w-[60%] md:min-w-0">
        <div class="flex items-start justify-between">
          <Icon name="lucide:quote" class="size-7 text-slate-200" />
          <div class="flex gap-0.5 text-star">{[0, 1, 2, 3, 4].map(() => <Icon name="lucide:star" class="size-3.5 fill-current" />)}</div>
        </div>
        <blockquote class="mt-3 text-[13px] leading-relaxed text-muted">“{t.text}”</blockquote>
        <figcaption class="mt-5 flex items-center gap-3">
          <img src={t.avatar} alt="" class="size-8 rounded-full object-cover" />
          <span class="leading-tight"><span class="block text-[13px] font-semibold text-navy">{t.name}</span><span class="text-[11px] text-muted">{t.city}</span></span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="mt-5 flex justify-center gap-1" aria-hidden="true">
    <span class="h-1 w-4 rounded-full bg-brand"></span><span class="size-1 rounded-full bg-slate-300"></span><span class="size-1 rounded-full bg-slate-300"></span>
  </div>
</Section>
