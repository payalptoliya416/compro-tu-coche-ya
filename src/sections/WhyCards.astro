---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
const { title, text, items, gray = false } = Astro.props;
const offsets = ['md:mt-0', 'md:mt-11', 'md:mt-4', 'md:mt-7'];
---
<Section gray={gray}>
  <SectionTitle title={title} text={text} />
  <ul class:list={['grid items-start gap-4 sm:grid-cols-2', items.length === 4 && 'lg:grid-cols-4']}>
    {items.map((it, i) => (
      <li class:list={['min-h-[160px] rounded-xl bg-white p-5 shadow-[0_10px_30px_rgba(11,42,91,0.07)]', offsets[i % 4]]}>
        <span class:list={['mb-4 grid size-9 place-items-center rounded-full', i % 2 === 0 ? 'bg-brand/10 text-brand' : 'bg-surface text-navy']}>
          <Icon name={it.icon} class="size-4" />
        </span>
        <h3 class="text-[14px] font-semibold text-navy">{it.title}</h3>
        <p class="mt-1.5 text-[12.5px] leading-relaxed text-muted">{it.text}</p>
      </li>
    ))}
  </ul>
</Section>
