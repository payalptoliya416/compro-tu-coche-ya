---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
const { title, text, items, gray = false } = Astro.props;
// Staggered vertical offsets matching the screenshot cascade
const offsets = ['md:mt-0', 'md:mt-16', 'md:mt-6', 'md:mt-20'];
---
<Section gray={gray}>
  <SectionTitle title={title} text={text} />
  <ul class:list={['grid items-start gap-4 sm:grid-cols-2', items.length === 4 && 'lg:grid-cols-4']}>
    {items.map((it, i) => (
      <li class:list={['rounded-2xl bg-white px-5 xl:px-7 py-8 md:py-16 lg:py-[90px] text-center sm:text-left shadow-[0_4px_24px_rgba(11,42,91,0.08)]', offsets[i % 4]]}>
        <span class:list={['mb-7 grid size-[60px] place-items-center rounded-full mx-auto sm:mx-0', i % 2 === 0 ? 'bg-brand/10 text-brand' : 'bg-surface text-navy']}>
          <Icon name={it.icon} class="size-5" />
        </span>
        <h3 class="text-lg font-medium text-navy">{it.title}</h3>
        <p class="mt-3 text-base text-[#677A92]">{it.text}</p>
      </li>
    ))}
  </ul>
</Section>
