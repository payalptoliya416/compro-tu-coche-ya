---
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
const { title, text, steps, gray = false, class: cls = '' } = Astro.props;
---
<Section gray={gray} class={cls}>
  <SectionTitle title={title} text={text} />
  <ol class="relative grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4">
    <div class="absolute left-[12.5%] right-[12.5%] top-8 hidden h-px bg-line lg:block" aria-hidden="true"></div>
    {steps.map((s, i) => (
      <li class="relative text-center">
        <span class="mx-auto mb-[33px] grid size-[72px] place-items-center rounded-full bg-white text-xl text-[#9AA6B7] ring-[13px] ring-[#F2F4F6]">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="text-xl text-navy">{s.title}</h3>
        <p class="mx-auto mt-2 max-w-[270px] text-base leading-relaxed text-[#677A92]">{s.text}</p>
      </li>
    ))}
  </ol>
</Section>
