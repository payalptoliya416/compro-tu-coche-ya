---
const pins = [
  { n: 'MADRID', x: 178, y: 138 },
  { n: 'BARCELONA', x: 338, y: 84 },
  { n: 'VALENCIA', x: 302, y: 152 },
  { n: 'SEVILLA', x: 110, y: 222 },
  { n: 'ALICANTE', x: 282, y: 186 },
];
---
<div class="rounded-2xl bg-surface p-4 md:p-8">
  <svg viewBox="0 0 420 320" class="w-full" role="img" aria-label="Map of Spain with pickup cities">
    <defs>
      <filter id="map-shadow" x="-20%" y="-20%" width="140%" height="160%">
        <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#0b2a5b" flood-opacity=".15" />
      </filter>
    </defs>
    <g filter="url(#map-shadow)" fill="#fff" stroke="#e3e8f0" stroke-width="2" stroke-linejoin="round">
      <path d="M48 52 96 38 160 34 230 40 296 44 336 66 352 96 330 118 318 142 296 170 276 198 244 222 198 240 160 258 122 268 96 246 80 214 84 176 70 140 56 110 40 84Z" />
      <ellipse cx="372" cy="150" rx="14" ry="8" /><ellipse cx="392" cy="140" rx="8" ry="5" /><ellipse cx="360" cy="168" rx="6" ry="4" />
    </g>
    <path d="M110 222C130 180 150 150 178 138S280 90 338 84M178 138 302 152 282 186" fill="none" stroke="var(--color-brand)" stroke-width="1.5" stroke-dasharray="4 4" />
    {pins.map((p) => (
      <g transform={`translate(${p.x} ${p.y})`}>
        <path d="M0 0C-8-10-10-16-10-20a10 10 0 1 1 20 0C10-16 8-10 0 0Z" fill="var(--color-brand)" />
        <circle cy="-20" r="4" fill="#fff" />
        <rect x="-22" y="4" width="44" height="12" rx="3" fill="var(--color-navy)" />
        <text y="12.5" text-anchor="middle" font-size="6" font-weight="700" fill="#fff" font-family="sans-serif">{p.n}</text>
      </g>
    ))}
  </svg>
</div>
