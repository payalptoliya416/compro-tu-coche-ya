---
import { images } from '../data/images';
import { stats } from '../data/site';
---
<section class="px-[30px]">
  <div class="relative isolate overflow-hidden rounded-3xl bg-navy px-4 py-14 text-center text-white md:py-[110px]">
    <img src={images.statsBg} alt="" class="absolute inset-0 -z-20 size-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-navy/90"></div>
    <h2 class="h2 !text-white">Selling your car has never been easier</h2>
    <p class="mt-4 lead !font-normal">A simple process, from valuation to payment.</p>
    <dl class="wrap mt-10 grid grid-cols-2 gap-y-8 md:grid-cols-4 md:divide-x md:divide-white/15">
      {stats.map((s) => (
        <div>
          <dt class="text-3xl font-medium text-brand md:text-4xl">{s.value}</dt>
          <dd class="mt-4 text-base">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
