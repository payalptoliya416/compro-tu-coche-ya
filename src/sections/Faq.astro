---
import { Icon } from 'astro-icon/components';
import Section from '../components/Section.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { faqs } from '../data/site';
---
<Section id="faq">
  <SectionTitle title="Everything you need to know" text="Answers to frequently asked questions." />
  <div class="mx-auto max-w-[820px] space-y-6">
    {faqs.map((f, i) => (
      <details name="faq" open={i === 0} class="group rounded-full open:rounded-[18px] bg-[#F2F4F6]">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 pl-6 pr-2 py-2 text-base lg:text-lg text-[#354D6E] [&::-webkit-details-marker]:hidden">
          {f.q}
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white text-navy group-open:text-brand">
            <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="group-open:hidden">
              <path d="M3.46155 15L15 3.46155M15 12.1154V3.46155H6.34616" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden rotate-90 group-open:block">
              <path d="M3.46155 15L15 3.46155M15 12.1154V3.46155H6.34616" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <p class="ml-6 mr-2 border-t border-[#CCD3DB] pt-5 pb-6 text-sm lg:text-base leading-relaxed text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</Section>
